// Styles for the HTML-only sidebar table of contents. The panel is driven by
// `--letmeout-toc-progress` (0 = closed, 1 = open), so a finger drag and a
// button press share one continuous motion. Large screens start open and
// narrow ones closed; the button only shows for fine pointers and swiping is
// only wired up for touch, as described by `pointer` media features.

#let toc-width = "17rem"
#let toc-breakpoint = "64rem"

#let toc-css = (
  // Headings are link targets, so in-page jumps are smooth by default.
  "html { scroll-behavior: smooth; }"
  // The neutral translations: expanded on a wide screen, hidden on a narrow one.
  + ":root { --letmeout-toc-progress: 1; }"
  + "@media (max-width: calc(" + toc-breakpoint + " - 0.02px)) { :root { --letmeout-toc-progress: 0; } }"
  + ":root { --letmeout-toc-width: " + toc-width + ";"
  + " --letmeout-toc-ease: cubic-bezier(0.22, 0.61, 0.36, 1);"
  + " --letmeout-toc-line: light-dark(rgb(0 0 0 / 0.1), rgb(255 255 255 / 0.14));"
  + " --letmeout-toc-surface: light-dark(rgb(252 252 250 / 0.88), rgb(24 24 27 / 0.86));"
  + " --letmeout-toc-muted: light-dark(rgb(82 82 91 / 0.92), rgb(212 212 216 / 0.78));"
  + " --letmeout-toc-ink: light-dark(rgb(24 24 27), rgb(244 244 245));"
  + " --letmeout-toc-accent: light-dark(rgb(37 99 235), rgb(96 165 250));"
  + " --letmeout-toc-highlight: light-dark(rgb(37 99 235 / 0.1), rgb(96 165 250 / 0.18));"
  + " }"
  // The panel itself. The translation keeps it off screen without a scrollbar.
  + " .letmeout-toc { position: fixed; inset-block: 0; inset-inline-start: 0; z-index: 2147483000;"
  + " display: flex; flex-direction: column; width: min(var(--letmeout-toc-width), 86vw);"
  + " box-sizing: border-box; overflow: hidden; touch-action: pan-y;"
  + " border-inline-end: 1px solid var(--letmeout-toc-line);"
  + " background: var(--letmeout-toc-surface); color: var(--letmeout-toc-ink);"
  + " -webkit-backdrop-filter: blur(16px) saturate(1.4); backdrop-filter: blur(16px) saturate(1.4);"
  + " font: 0.875rem/1.45 system-ui, -apple-system, 'Segoe UI', sans-serif;"
  + " transform: translate3d(calc((var(--letmeout-toc-progress) - 1) * (100% + 1px)), 0, 0);"
  + " transition: transform 0.32s var(--letmeout-toc-ease);"
  + " }"
  // A closed panel is out of reach for the keyboard and screen readers too.
  + " .letmeout-toc[data-state=closed] { visibility: hidden;"
  + " transition: transform 0.32s var(--letmeout-toc-ease), visibility 0s linear 0.32s; }"
  + " .letmeout-toc[data-state=open] { visibility: visible;"
  + " transition: transform 0.32s var(--letmeout-toc-ease), visibility 0s linear 0s; }"
  + " .letmeout-toc[dir=rtl], [dir=rtl] .letmeout-toc {"
  + " transform: translate3d(calc((1 - var(--letmeout-toc-progress)) * (100% + 1px)), 0, 0); }"
  + " .letmeout-toc-head { display: flex; align-items: center; gap: 0.5rem;"
  + " padding: 0.75rem 0.75rem 0.5rem 1rem; }"
  + " .letmeout-toc-title { flex: 1 1 auto; min-width: 0; margin: 0; font-size: 0.75rem;"
  + " font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase;"
  + " color: var(--letmeout-toc-muted); }"
  + " .letmeout-toc-list { position: relative; flex: 1 1 auto; overflow-y: auto;"
  + " overscroll-behavior: contain; margin: 0; padding: 0.25rem 0.5rem 1.25rem; list-style: none; }"
  + " .letmeout-toc-list li { margin: 0; }"
  + " .letmeout-toc-link { display: block; padding: 0.3rem 0.6rem; border-radius: 0.4rem;"
  + " padding-inline-start: calc(0.6rem + var(--letmeout-toc-depth, 0) * 0.8rem);"
  + " color: var(--letmeout-toc-muted); text-decoration: none;"
  + " overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
  + " transition: color 0.15s ease, background-color 0.15s ease; }"
  + " .letmeout-toc-link:hover, .letmeout-toc-link:focus-visible {"
  + " color: var(--letmeout-toc-ink); background: var(--letmeout-toc-highlight); }"
  + " .letmeout-toc-link[aria-current=location] { color: var(--letmeout-toc-accent);"
  + " background: var(--letmeout-toc-highlight); font-weight: 600; }"
  // Buttons: a floating opener while closed, a closer in the panel head.
  + " .letmeout-toc-toggle { appearance: none; -webkit-appearance: none; margin: 0;"
  + " display: grid; place-items: center; width: 2.25rem; height: 2.25rem; padding: 0;"
  + " border: 1px solid var(--letmeout-toc-line); border-radius: 0.6rem;"
  + " background: var(--letmeout-toc-surface); color: var(--letmeout-toc-ink);"
  + " -webkit-backdrop-filter: blur(16px) saturate(1.4); backdrop-filter: blur(16px) saturate(1.4);"
  + " box-shadow: 0 6px 18px -10px rgb(0 0 0 / 0.35); cursor: pointer;"
  + " font: inherit; line-height: 1; }"
  + " .letmeout-toc-toggle:hover { background: var(--letmeout-toc-highlight); }"
  + " .letmeout-toc-opener { position: fixed; inset-block-start: 0.75rem; inset-inline-start: 0.75rem;"
  + " z-index: 2147483001; display: none; }"
  // Mouse and trackpad users get the button; touch users swipe instead.
  + " @media (pointer: fine) {"
  + " .letmeout-toc-opener { display: block; }"
  + " .letmeout-toc[data-state=open] ~ .letmeout-toc-opener { display: none; }"
  + " }"
  + "@media (pointer: coarse) { .letmeout-toc-close { display: none; } }"
  // On narrow screens the panel floats over a dimmed page. The backdrop follows
  // the same progress variable, so it fades while the finger moves.
  + " .letmeout-toc-backdrop { display: none; }"
  + " @media (max-width: calc(" + toc-breakpoint + " - 0.02px)) {"
  + " .letmeout-toc-backdrop { display: block; position: fixed; inset: 0; z-index: 2147482999;"
  + " background: rgb(0 0 0 / 0.3); opacity: var(--letmeout-toc-progress);"
  + " touch-action: pan-y; pointer-events: none;"
  + " transition: opacity 0.32s var(--letmeout-toc-ease); }"
  + " .letmeout-toc[data-state=open] ~ .letmeout-toc-backdrop,"
  + " .letmeout-toc-dragging .letmeout-toc-backdrop { pointer-events: auto; }"
  + " }"
  // A small grip hints at the swipe on touch screens.
  + " .letmeout-toc-grip { display: none; }"
  + " @media (pointer: coarse) { .letmeout-toc-grip { display: block; position: fixed;"
  + " inset-inline-start: 0; top: 50%; z-index: 2147482998; width: 0.3rem; height: 3rem;"
  + " transform: translateY(-50%); border-start-end-radius: 999px; border-end-end-radius: 999px;"
  + " background: var(--letmeout-toc-muted); opacity: 0.45; pointer-events: none;"
  + " transition: opacity 0.2s ease; }"
  + " .letmeout-toc[data-state=open] ~ .letmeout-toc-grip { opacity: 0; } }"
  // On wide screens the page makes room for the panel instead.
  + " @media (min-width: " + toc-breakpoint + ") {"
  + " body { padding-inline-start: calc(var(--letmeout-toc-progress) * (var(--letmeout-toc-width) + 1px));"
  + " transition: padding-inline-start 0.32s var(--letmeout-toc-ease); }"
  + " }"
  // During a drag the finger owns the motion: no easing, no transition.
  + " .letmeout-toc-dragging, .letmeout-toc-dragging body,"
  + " .letmeout-toc-dragging .letmeout-toc, .letmeout-toc-dragging .letmeout-toc-backdrop {"
  + " transition: none !important; }"
  + " .letmeout-toc-dragging .letmeout-toc { visibility: visible; }"
  + " .letmeout-toc-dragging .letmeout-toc-opener,"
  + " .letmeout-toc-dragging .letmeout-toc-close { display: none !important; }"
  + " @media (prefers-reduced-motion: reduce) {"
  + " .letmeout-toc, .letmeout-toc-backdrop, body { transition-duration: 0.001s !important; }"
  + " html { scroll-behavior: auto !important; } }"
  + " @media print { .letmeout-toc, .letmeout-toc-opener, .letmeout-toc-backdrop,"
  + " .letmeout-toc-grip { display: none !important; }"
  + " body { padding-inline-start: 0 !important; } }"
)
